generator client {
  provider = "prisma-client-js"
} //prisma que vamos usar para conexão

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} //configuração do bd para conexão com o prisma

model User {
  id        String      @id @default(uuid())
  name      String
  email     String   @unique
  @@map("users")

} 